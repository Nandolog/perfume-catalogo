@using PerfumeCatalog.Client.Services
@inject TemaService TemaService
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<header class="navbar-moderna">
    <div class="container">
        <a href="/" class="navbar-brand-moderna">
            🌸 Boutique Norma
        </a>

        <button class="navbar-toggle" @onclick="ToggleMenu">
            ☰
        </button>

        <ul class="navbar-links @(menuAbierto ? "show" : "")">
            <li>
                <NavLink class="navbar-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
            </li>
            <li>
                <NavLink class="navbar-link" href="productos">Productos</NavLink>
            </li>
            @if (esAdmin)
            {
                <li>
                    <NavLink class="navbar-link" href="admin">Panel</NavLink>
                </li>
                <li>
                    <NavLink class="navbar-link" href="admin/categorias">Categorías</NavLink>
                </li>
                <li>
                    <NavLink class="navbar-link" href="perfil">Perfil</NavLink>
                </li>
            }
        </ul>

        <div class="navbar-actions">
    <button class="btn-tema" @onclick="CambiarTema" title="Cambiar tema">
        @if (TemaService.TemaActual == "dark")
        {
            <span>☀️</span>
        }
        else
        {
            <span>🌙</span>
        }
    </button>

    @if (esAdmin)
    {
        <button class="btn-pdf-small" @onclick="CerrarSesion">Salir</button>
    }
</div>
    </div>
</header>

@code {
    private bool esAdmin;
    private bool menuAbierto;

    protected override async Task OnInitializedAsync()
    {
        await VerificarAuth();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // No usar async void. Programar con InvokeAsync para asegurarnos
        // de correr en el Dispatcher de Blazor.
        _ = InvokeAsync(async () =>
        {
            await VerificarAuth();
            StateHasChanged();
        });
    }

    private async Task VerificarAuth()
    {
        try
        {
            esAdmin = await Auth.EstaAutenticadoAsync();
        }
        catch
        {
            esAdmin = false;
        }
    }

    private void ToggleMenu() => menuAbierto = !menuAbierto;

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
    
    private async Task CambiarTema()
    {
    await TemaService.AlternarAsync();
    }
}