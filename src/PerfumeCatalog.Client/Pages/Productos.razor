@page "/productos"
@using PerfumeCatalog.Client.Models
@using PerfumeCatalog.Client.Services
@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Productos — Boutique Norma</PageTitle>

<div class="container productos-page">
    <div class="productos-page">

    <div class="header-catalogo">
        <h1>🛍️ Productos</h1>
        @if (productosFiltrados.Count > 0)
        {
            <div class="header-acciones">
                <button class="btn-whatsapp-header" @onclick="CompartirCatalogoWhatsApp">
                    📱 Compartir
                </button>
                <button class="btn-pdf" @onclick="DescargarCatalogoPDF">
                    📄 PDF completo
                </button>
            </div>
        }
    </div>

    <!-- Buscador -->
    <div class="buscador-container">
        <input type="text"
               class="buscador"
               placeholder="🔍 Buscar producto..."
               @bind="textoBusqueda"
               @bind:event="oninput" />
    </div>

    <!-- Chips de categorías -->
    <div class="categorias-chips">
        <button class="chip @(categoriaSeleccionada is null ? "chip-activo" : "")"
                @onclick="() => SeleccionarCategoria(null)">
            Todos (@productos.Count)
        </button>
        @foreach (var cat in categorias)
        {
            var cantidad = productos.Count(p => p.CategoriaId == cat.Id);
            <button class="chip @(categoriaSeleccionada == cat.Id ? "chip-activo" : "")"
                    @onclick="() => SeleccionarCategoria(cat.Id)">
                @cat.Emoji @cat.Nombre (@cantidad)
            </button>
        }
    </div>

    <!-- Lista de productos -->
    @if (cargando)
    {
        <p>Cargando productos...</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="error-box">
            <strong>Error:</strong> @error
        </div>
    }
    else if (productosFiltrados.Count == 0)
    {
        <div class="sin-resultados">
            <p>😕 No se encontraron productos con esos filtros.</p>
            @if (!string.IsNullOrEmpty(textoBusqueda) || categoriaSeleccionada is not null)
            {
                <button class="btn-cancelar" @onclick="LimpiarFiltros">
                    Limpiar filtros
                </button>
            }
        </div>
    }
    else
    {
        <p class="resultado-count">
            Mostrando @productosFiltrados.Count de @productos.Count productos
        </p>

        <div class="catalogo">
            @foreach (var p in productosFiltrados)
            {
               <div class="producto-card">
    <a href="/producto/@p.Id" class="producto-link">
        @if (!string.IsNullOrEmpty(p.ImagenUrl))
        {
            <img src="@p.ImagenUrl" alt="@p.Nombre" />
        }
        <div class="producto-info">
            <span class="categoria">
                @{
                    var cat = categorias.FirstOrDefault(c => c.Id == p.CategoriaId);
                    @(cat is not null ? $"{cat.Emoji} {cat.Nombre}" : p.Categoria)
                }
            </span>
            <h3>@p.Nombre</h3>
            <p>@p.Descripcion</p>
            <strong class="precio">Gs. @p.Precio.ToString("N0")</strong>
        </div>
    </a>
    <div class="producto-acciones-externas">
        <button class="btn-whatsapp" @onclick="() => CompartirWhatsApp(p)">
            📱 Compartir
        </button>
        <button class="btn-pdf-small" @onclick="() => DescargarPDFProducto(p)">
            📄 PDF
        </button>
    </div>
</div>
            }
        </div>
    }
</div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "categoria")]
    public int? CategoriaFiltroInicial { get; set; }

    private List<Producto> productos = new();
    private List<Categoria> categorias = new();
    private bool cargando = true;
    private string? error;

    private string textoBusqueda = "";
    private int? categoriaSeleccionada;

    private List<Producto> productosFiltrados => Filtrar(productos);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await ProductoService.ObtenerProductosAsync();
            categorias = await CategoriaService.ObtenerTodasAsync();
            categoriaSeleccionada = CategoriaFiltroInicial;
        }
        catch (Exception ex)
        {
            error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private List<Producto> Filtrar(List<Producto> origen)
    {
        var query = origen.AsEnumerable();

        if (categoriaSeleccionada is not null)
        {
            query = query.Where(p => p.CategoriaId == categoriaSeleccionada);
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var busqueda = textoBusqueda.Trim().ToLowerInvariant();
            query = query.Where(p =>
                (p.Nombre ?? "").ToLowerInvariant().Contains(busqueda) ||
                (p.Descripcion ?? "").ToLowerInvariant().Contains(busqueda));
        }

        return query.ToList();
    }

    private void SeleccionarCategoria(int? categoriaId)
    {
        categoriaSeleccionada = categoriaId;
        // Actualizamos la URL sin recargar la página
        var url = categoriaId is null ? "/productos" : $"/productos?categoria={categoriaId}";
        Nav.NavigateTo(url, replace: true);
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        SeleccionarCategoria(null);
    }

    private async Task CompartirWhatsApp(Producto p)
    {
        var cat = categorias.FirstOrDefault(c => c.Id == p.CategoriaId);
        var nombreCat = cat is not null ? $"{cat.Emoji} {cat.Nombre}" : p.Categoria;

        var texto = $"🌸 {p.Nombre}\n" +
                    $"Categoría: {nombreCat}\n" +
                    $"{p.Descripcion}\n" +
                    $"💵 Precio: Gs. {p.Precio:N0}\n\n" +
                    $"¿Te interesa? Escribime 😊";
        await JS.InvokeVoidAsync("compartirWhatsApp", texto, null);
    }

    private async Task CompartirCatalogoWhatsApp()
    {
        var lineas = new List<string> { "🌸 *Boutique Norma*", "" };
        foreach (var p in productosFiltrados)
        {
            lineas.Add($"*{p.Nombre}*");
            lineas.Add($"Gs. {p.Precio:N0}");
            if (!string.IsNullOrWhiteSpace(p.Descripcion))
                lineas.Add(p.Descripcion);
            lineas.Add("");
        }
        lineas.Add("¿Te interesa alguno? Escribime 😊");
        var texto = string.Join("\n", lineas);
        await JS.InvokeVoidAsync("compartirWhatsApp", texto, null);
    }

    private async Task DescargarPDFProducto(Producto p)
    {
        var datos = new
        {
            nombre = p.Nombre ?? "",
            descripcion = p.Descripcion ?? "",
            precio = (double)p.Precio,
            categoria = p.Categoria ?? ""
        };
        await JS.InvokeVoidAsync("generarPDFProducto", (object)datos);
    }

    private async Task DescargarCatalogoPDF()
    {
        var lista = productosFiltrados.Select(p => new
        {
            nombre = p.Nombre ?? "",
            descripcion = p.Descripcion ?? "",
            precio = (double)p.Precio,
            categoria = p.Categoria ?? ""
        }).ToArray();
        await JS.InvokeVoidAsync("generarPDFCatalogo", (object)lista);
    }
}