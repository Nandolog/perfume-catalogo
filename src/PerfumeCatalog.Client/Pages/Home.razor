@page "/"
@using PerfumeCatalog.Client.Models
@using PerfumeCatalog.Client.Services
@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Boutique Norma — Perfumes, moda y accesorios</PageTitle>

<!-- HERO -->
<section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>🌸 Boutique Norma</h1>
        <p class="hero-subtitulo">Perfumes, moda y accesorios con amor</p>
        <button class="btn-hero" @onclick="IrAProductos">
            Ver productos →
        </button>
    </div>
</section>

<!-- SOBRE NOSOTROS -->
<section class="sobre-nosotros">
    <div class="container">
        <h2>Sobre nosotros</h2>
        <p>
            Bienvenidos a <strong>Boutique Norma</strong>, tu tienda de confianza.
            Ofrecemos perfumes originales, ropa de calidad y accesorios seleccionados
            con dedicación. Cada producto está pensado para hacerte sentir especial.
        </p>
        <p class="sobre-firma">— Con cariño, la familia 💕</p>
    </div>
</section>

<!-- CATEGORÍAS -->
@if (categorias.Count > 0)
{
    <section class="categorias-home">
        <div class="container">
            <h2>Explorá por categoría</h2>
            <div class="categorias-grid">
                @foreach (var cat in categorias)
                {
                    <button class="categoria-card" @onclick="() => IrACategoria(cat.Id)">
                        <span class="categoria-emoji">@cat.Emoji</span>
                        <span class="categoria-nombre">@cat.Nombre</span>
                    </button>
                }
            </div>
        </div>
    </section>
}

<!-- PRODUCTOS DESTACADOS -->
@if (productosDestacados.Count > 0)
{
    <section class="destacados-home">
        <div class="container">
            <div class="destacados-header">
                <h2>Productos destacados</h2>
                <button class="btn-ver-todos" @onclick="IrAProductos">
                    Ver todos →
                </button>
            </div>

            <div class="catalogo">
                @foreach (var p in productosDestacados)
                {
                    <div class="producto-card">
                        <a href="/producto/@p.Id" class="producto-link">
                            @if (!string.IsNullOrEmpty(p.ImagenUrl))
                            {
                                <img src="@p.ImagenUrl" alt="@p.Nombre" />
                            }
                            <div class="producto-info">
                                <span class="categoria">@p.Categoria</span>
                                <h3>@p.Nombre</h3>
                                <p>@p.Descripcion</p>
                                <strong class="precio">Gs. @p.Precio.ToString("N0")</strong>
                            </div>
                        </a>
                        <div class="producto-acciones-externas">
                            <button class="btn-whatsapp" @onclick="() => CompartirWhatsApp(p)">📱 Compartir</button>
                            <button class="btn-pdf-small" @onclick="() => DescargarPDFProducto(p)">📄 PDF</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- CONTACTO -->
<section class="contacto-home">
    <div class="container">
        <h2>Contactanos</h2>
        <p>¿Tenés alguna consulta? Escribinos por WhatsApp.</p>
        <button class="btn-whatsapp-contacto" @onclick="ContactarWhatsApp">
            📱 Escribir por WhatsApp
        </button>
    </div>
</section>

@code {
    private const string WhatsAppNumero = "595993377636";

    private List<Producto> productosDestacados = new();
    private List<Categoria> categorias = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todos = await ProductoService.ObtenerProductosAsync();
            productosDestacados = todos.Take(6).ToList();

            categorias = await CategoriaService.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando home: {ex.Message}");
            throw;
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrAProductos() => Nav.NavigateTo("/productos");
    private void IrACategoria(int categoriaId) => Nav.NavigateTo($"/productos?categoria={categoriaId}");

    private async Task ContactarWhatsApp()
    {
        var texto = "¡Hola! Vi el catálogo de Boutique Norma y quería consultar algo 😊";
        await JS.InvokeVoidAsync("compartirWhatsApp", texto,
            string.IsNullOrEmpty(WhatsAppNumero) ? null : WhatsAppNumero);
    }

    private async Task CompartirWhatsApp(Producto p)
    {
        var texto = $"🌸 {p.Nombre}\n" +
                    $"Categoría: {p.Categoria}\n" +
                    $"{p.Descripcion}\n" +
                    $"💵 Precio: Gs. {p.Precio:N0}\n\n" +
                    $"¿Te interesa? Escribime 😊";
        await JS.InvokeVoidAsync("compartirWhatsApp", texto, null);
    }

    private async Task DescargarPDFProducto(Producto p)
    {
        var datos = new
        {
            nombre = p.Nombre ?? "",
            descripcion = p.Descripcion ?? "",
            precio = (double)p.Precio,
            categoria = p.Categoria ?? ""
        };
        await JS.InvokeVoidAsync("generarPDFProducto", (object)datos);
    }
}