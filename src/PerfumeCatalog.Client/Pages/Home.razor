@page "/"
@inject NavigationManager Nav

<PageTitle>Boutique Norma</PageTitle>

<div class="home-placeholder">
    <h1>🌸 Boutique Norma</h1>
    <p>Bienvenidos a nuestra tienda.</p>
    <button class="btn-primario" @onclick="IrAProductos" style="max-width: 300px; margin: 1rem auto; display:block;">
        Ver productos
    </button>
</div>

@code {
    private void IrAProductos() => Nav.NavigateTo("/productos");
}