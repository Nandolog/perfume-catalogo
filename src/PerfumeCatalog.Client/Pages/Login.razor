@page "/login"
@using PerfumeCatalog.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesion</PageTitle>
<div class="login-page">
    <div class="login-container">
    <h2>Iniciar sesion</h2>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class = "error-box">@error</div>
    }

    <div class = "form-group">
        <label>Email</label>
        <input type = "email" @bind = "email" placeholder = "Ingrese su email" />
    </div>

    <div class = "form-group">
        <label>Contraseña</label>
        <input type = "password" @bind = "password" placeholder = "••••••••" 
        @onkeydown = "OnkeyDown" />
    </div>

    <button class = "btn-primario" @onclick = "Ingresar" disabled = "@cargando">
        @(cargando ? "Ingresando..." : "Entrar")
        </button>
        <p class = "hind">Solo para  administrador</p>
</div>

</div>

@code {
    private string email = "";
    private string password = "";
    private string error;
    private bool cargando;


    private async Task Ingresar()
    {
        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            error = "Por favor, complete todos los campos.";
            return;
        }

        cargando = true;
        error = null;

        try
        {
            var session = await Auth.LoginAsync(email, password);
            if (session?.User != null)
            {
                Nav.NavigateTo("/admin");
            }
            else
            {
                error = "Credenciales inválidas. Intente nuevamente.";
            }
        }

        catch (Exception ex)
        {
            error = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task OnkeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Ingresar();
        }
    }
}
